{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/project-profile.schema.json",
  "title": "Engineering Platform Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "platform",
    "localization",
    "runtime",
    "capabilities",
    "settings",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "consumerMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2
        },
        "consumerMode": {
          "const": "independent-repository"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionRange",
        "artifactBoundary"
      ],
      "properties": {
        "versionRange": {
          "type": "string",
          "minLength": 1
        },
        "artifactBoundary": {
          "enum": [
            "versioned-tarball",
            "npm-registry"
          ]
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledLocales",
        "defaultLocale",
        "rtlLocales"
      ],
      "properties": {
        "enabledLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        },
        "defaultLocale": {
          "type": "string"
        },
        "rtlLocales": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web",
        "api",
        "node",
        "database"
      ],
      "properties": {
        "web": {
          "enum": [
            "nextjs-16"
          ]
        },
        "api": {
          "enum": [
            "nestjs-fastify-modular-monolith"
          ]
        },
        "node": {
          "enum": [
            "24.x"
          ]
        },
        "database": {
          "enum": [
            "postgresql-18"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "enabled",
          "disabled",
          "deferred"
        ]
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledScopes",
        "tenantScope"
      ],
      "properties": {
        "enabledScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "platform",
              "project",
              "environment",
              "tenant",
              "user"
            ]
          }
        },
        "tenantScope": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineRisk",
        "trustRootRequired"
      ],
      "properties": {
        "baselineRisk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "trustRootRequired": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "settings": {
            "properties": {
              "tenantScope": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "settings": {
            "properties": {
              "enabledScopes": {
                "not": {
                  "contains": {
                    "const": "tenant"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}