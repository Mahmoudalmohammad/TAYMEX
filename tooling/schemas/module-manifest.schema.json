{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/module-manifest.schema.json",
  "title": "Engineering Platform Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "layer",
    "owner",
    "tags",
    "dependencies",
    "data",
    "settings",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "layer": {
      "enum": [
        "kernel",
        "foundation",
        "capability",
        "domain"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedModules",
        "allowedTags"
      ],
      "properties": {
        "allowedModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowedTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "readsViaContracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "sensitive"
          ]
        },
        "adapter": {
          "enum": [
            "drizzle-postgres",
            "external",
            "none"
          ]
        },
        "schemaRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defines",
        "consumes"
      ],
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defines",
        "consumes"
      ],
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns",
        "consumes"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "securityTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "performanceTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extensionModes": {
      "type": "array",
      "items": {
        "enum": [
          "USE",
          "CONFIGURE",
          "EXTEND",
          "REPLACE",
          "OPT_OUT"
        ]
      },
      "uniqueItems": true
    },
    "sourceRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "internalOnly": {
          "type": "boolean"
        }
      }
    }
  }
}
