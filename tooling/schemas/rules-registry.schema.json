{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Platform Rules Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "implementationStatus",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "implementationStatus": {
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "minItems": 1
    }
  }
}
