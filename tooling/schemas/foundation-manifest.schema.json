{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/foundation-manifest.schema.json",
  "title": "Application Foundation Readiness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "foundation", "capabilities", "deferredDomainCapabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "featureExpansionPolicy", "maturityOrder", "readinessRule", "validationSlice"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "featureExpansionPolicy": {"const": "BLOCK_UNTIL_READY"},
        "maturityOrder": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"enum": ["NOT_STARTED", "DESIGNED", "IMPLEMENTED", "INTEGRATED", "PROVEN", "PRODUCTION_PROVEN"]}
        },
        "readinessRule": {"type": "string", "minLength": 10},
        "currentStage": {"type": "string"},
        "validationSlice": {
          "type": "object", "additionalProperties": false,
          "required": ["module", "status", "resumeCondition"],
          "properties": {
            "module": {"type": "string"},
            "status": {"type": "string"},
            "resumeCondition": {"type": "string"}
          }
        }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "area", "requiredBeforeFeatureExpansion", "currentMaturity", "exitMaturity", "owner", "purpose", "evidence", "remaining"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "area": {"type": "string", "minLength": 2},
          "requiredBeforeFeatureExpansion": {"type": "boolean"},
          "currentMaturity": {"enum": ["NOT_STARTED", "DESIGNED", "IMPLEMENTED", "INTEGRATED", "PROVEN", "PRODUCTION_PROVEN"]},
          "exitMaturity": {"enum": ["NOT_STARTED", "DESIGNED", "IMPLEMENTED", "INTEGRATED", "PROVEN", "PRODUCTION_PROVEN"]},
          "owner": {"type": "string", "minLength": 2},
          "purpose": {"type": "string", "minLength": 10},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "remaining": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "deferredDomainCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
