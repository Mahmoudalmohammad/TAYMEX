{
  "name": "taymex",
  "version": "0.0.0-private",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @taymex/web dev",
    "dev:api": "pnpm --filter @taymex/api dev",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "governance:boundary": "./scripts/platform consumer verify-boundary",
    "governance:trust": "./scripts/verify-trust-local.sh",
    "platform:profile": "./scripts/platform project validate blueprints/project-profiles/taymex.yaml",
    "settings:generate": "python3 scripts/generate-settings-bindings.py",
    "settings:check": "python3 scripts/generate-settings-bindings.py --check",
    "permissions:generate": "python3 scripts/generate-permission-bindings.py",
    "permissions:check": "python3 scripts/generate-permission-bindings.py --check",
    "db:migrate": "pnpm --filter @taymex/data-postgres migrate",
    "api:generate": "python3 scripts/generate-api-contract-bindings.py",
    "api:check": "python3 scripts/generate-api-contract-bindings.py --check",
    "f5:verify": "python3 scripts/verify-f5-api-security.py",
    "security:secrets": "python3 scripts/verify-f5-api-security.py",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "f6:verify": "python3 scripts/verify-f6-performance.py",
    "f6:test:postgres": "node --test apps/api/tests/f6-performance.integration.test.mjs",
    "events:generate": "python3 scripts/generate-event-bindings.py",
    "events:check": "python3 scripts/generate-event-bindings.py --check",
    "f7:verify": "python3 scripts/verify-f7-files-side-effects.py",
    "f7:test:postgres": "node --test apps/api/tests/f7-files-side-effects.integration.test.mjs",
    "f8:verify": "python3 scripts/verify-f8-ui-ux.py",
    "f9:verify": "python3 scripts/verify-f9-production-delivery.py && python3 scripts/verify-f9-recovery.py",
    "f9:verify:recovery": "python3 scripts/verify-f9-recovery.py",
    "f9:drill:recovery": "python3 scripts/drill-f9-recovery.py"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "nx": "23.1.2",
    "typescript": "5.9.2"
  }
}
